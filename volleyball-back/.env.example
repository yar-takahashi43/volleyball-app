# ローカル開発例: PORT=5001 / CLIENT_ORIGIN=http://localhost:3000
# 本番（Render）例: PORT は Render が自動注入。CLIENT_ORIGIN は Static Site の HTTPS URL

PORT=5001
MONGOURL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/volleyball?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000

# 本番では NODE_ENV=production（Render が設定）。JWT_SECRET 未設定だと起動失敗する。
